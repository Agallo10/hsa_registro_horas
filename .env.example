# ---- PostgreSQL ----
POSTGRES_USER=registro
POSTGRES_PASSWORD=registro
POSTGRES_DB=registro_horas

# ---- Puertos ----
# Puerto interno del backend (y URL que usa nginx para el proxy)
BACKEND_PORT=3000
# Puerto del frontend: nginx escucha aquí y se publica al host
FRONTEND_PORT=81

# ---- JWT ----
JWT_ACCESS_SECRET=cambia-este-secreto-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=cambia-este-secreto-refresh
JWT_REFRESH_TTL=7d

# ---- API del frontend ----
# /api                       -> proxy de nginx a http://backend:<BACKEND_PORT> (recomendado)
# http://mi-host:3000/api    -> llamada directa (requiere CORS_ORIGIN en el backend)
API_URL=/api

# CORS (solo necesario si API_URL es absoluto/cross-origin)
# CORS_ORIGIN=https://mi-dominio
