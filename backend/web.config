<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración para IIS + iisnode.
  Estructura esperada en el sitio (raíz del sitio = carpeta del backend):
    web.config
    package.json
    node_modules/
    dist/main.js        (build del backend)
    dist/migrations/
    frontend/dist/      (build del frontend, servido por @nestjs/serve-static)
    .env                (configuración de producción)
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="LogFile" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="iisnode" />
        </rule>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^dist/main.js[\/]?debug" />
        </rule>
        <rule name="StaticContent" stopProcessing="true">
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      watchedFiles="*.js;web.config"
      node_env="production"
      loggingEnabled="true"
      devErrorsEnabled="false"
      nodeProcessCountPerApplication="1"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      maxNamedPipeConnectionPoolSize="512" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment=".env" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
